#!/usr/bin/env bash
# FESim 단일 러너 — ./dev done|gate|clear-check|test|check|doccheck|gc|fuzz|extract|transform|notes|verify-m002|verify-all|bake|replay|replay:verify|opening|saves|promote|link:put|perf|size
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

cmd="${1:-}"

PY="$ROOT/tools/pipeline/.venv/bin/python"
# 워크스페이스에 고정된 wrangler(어댑터 peer와 같은 버전)를 쓴다 — npx 즉석 다운로드 금지.
WRANGLER="$ROOT/apps/web/node_modules/.bin/wrangler"

check() { pnpm -r --if-present run typecheck; }
test_all() { pnpm -r --if-present run test; }
doccheck() { pnpm -C tools/doccheck run test; }

# ─ 마감(done) 보조 ─────────────────────────────────────────────────────────
# /clear 손실 점검 — "지금 컨텍스트를 버려도 사라지는 것이 없는가"를 기계로 답한다.
# 산문 체크리스트로 두면 매번 사람이 세 군데를 눈으로 확인해야 하고, 그 눈이 한 번 미끄러지면
# 미푸시 커밋이 통째로 잊힌다(세션은 초기화되고 작업 브랜치는 로컬 전용이다).
clear_report() {
  local branch="$1" bad=0 n ahead behind
  echo "-- /clear 손실 점검 --"
  n="$(git status --porcelain | wc -l)"
  if [ "$n" -eq 0 ]; then echo "  · 작업트리 클린"; else echo "  ☠ 미커밋 변경 ${n}건"; git status --short | sed 's/^/      /'; bad=1; fi

  ahead="$(git rev-list --count origin/main..main 2>/dev/null || echo "?")"
  if [ "$ahead" = "0" ]; then echo "  · main 푸시 완료 = 베타 게시됨"
  else echo "  ☠ main 미푸시 ${ahead}건 — 베타 채널에 안 올라갔다"; bad=1; fi

  behind="$(git rev-list --count "main..$branch" 2>/dev/null || echo "?")"
  if [ "$behind" = "0" ]; then echo "  · ${branch} = main 동기(게시 안 된 작업 없음)"
  else echo "  ☠ 미게시 커밋 ${behind}건 — ${branch} 브랜치에만 있다(베타 채널 미반영)"; bad=1; fi

  if [ "$bad" -eq 0 ]; then echo "== /clear 안전: 손실 없음 =="; return 0; fi
  echo "== ☠/clear 위험: 위 항목은 세션과 함께 잊힌다 =="
  return 1
}

# 마감 = 게이트 → main 병합(= 베타 게시) → 작업 브랜치 동기 → /clear 판정.
# ☠훅은 이 경로를 타지 않는다(훅 = ./dev gate) — 타면 게시가 자기를 다시 부른다.
publish_done() {
  local dry=0 branch head_msg
  [ "${1:-}" = "--dry-run" ] && dry=1
  branch="$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)"

  # 마감은 "지금 커밋된 것"을 내보내는 절차다 — 더러운 트리는 무엇을 게시하는지가 불명확하다.
  if [ -n "$(git status --porcelain)" ]; then
    echo "☠ 마감 중단: 작업트리가 더럽다 — 커밋 먼저"; git status --short; return 1
  fi
  if [ "$branch" = "main" ]; then
    echo "☠ 마감 중단: main에서 실행됐다 — 작업 브랜치(beta)에서 돌려라"; return 1
  fi

  # ☠마감이 게이트보다 느슨하면 안 된다 — 여기가 **베타에 실제로 나가는** 자리다.
  #   종전엔 룰북·기보 신선도를 빼고 돌면서 "게이트 ALL GREEN"이라고 찍었다(2026-08-19에 낡은 기보
  #   5종이 그 문구 밑으로 통과했다). ./dev gate와 같은 항목을 같은 순서로 돈다.
  check && test_all && doccheck && rulebook_check && replay_check \
    || { echo "☠ 마감 중단: 게이트 레드"; return 1; }
  echo "== 게이트 ALL GREEN =="

  if [ "$dry" = 1 ]; then
    echo "== --dry-run: 베타 게시 생략 =="
    clear_report "$branch"; return $?
  fi

  head_msg="$(git log -1 --format=%s "$branch")"
  # 훅 재진입 차단 — 같은 트리를 방금 게이트로 통과시켰다(머지 커밋은 트리를 바꾸지 않는다).
  export FESIM_PUBLISHING=1
  git checkout main || { unset FESIM_PUBLISHING; return 1; }
  if ! git merge --no-ff "$branch" -m "베타 게시: ${head_msg}"; then
    echo "☠ 병합 실패 — ${branch}로 되돌린다"; git merge --abort 2>/dev/null || true
    git checkout "$branch"; unset FESIM_PUBLISHING; return 1
  fi
  if ! git push origin main; then
    echo "☠ 푸시 실패 — main 병합은 로컬에 남아 있다(재시도: git push origin main)"
    git checkout "$branch"; unset FESIM_PUBLISHING; return 1
  fi
  echo "== 베타 게시: main 푸시 완료 (CF가 beta 채널을 갱신한다) =="
  git checkout "$branch" && git merge --ff-only main
  unset FESIM_PUBLISHING
  clear_report "$branch"
}

gc() {
  # design/에서 status: done 문서를 archive/로 이송 (문서 수명 규칙)
  local moved=0
  for f in design/*.md; do
    [ -e "$f" ] || continue
    if awk '/^---$/{n++; next} n==1 && /^status:[[:space:]]*done[[:space:]]*$/{found=1} n>=2{exit} END{exit !found}' "$f"; then
      mv "$f" archive/
      echo "gc: $f -> archive/"
      moved=1
    fi
  done
  [ "$moved" = 1 ] || echo "gc: 이송할 done 문서 없음"
}

rulebook_check() {
  # ☠낡은 룰북은 없는 룰북보다 나쁘다 — 코드에서 재생성한 것과 다르면 레드.
  node tools/rulebook/build.mjs --check
}

replay_check() {
  # ☠낡은 기보는 **화면에 그대로 나온다** — 맵 진입이 기본 기보를 자동 재생하므로(BoardIsland)
  #   룰을 올리고 기보를 안 고치면 모든 맵 첫 화면이 낡은 기록이 되고 배지만 조용히 내려앉는다.
  #   2026-08-19에 정확히 그렇게 5종이 통째로 낡았고 아무것도 빨개지지 않았다 ⇒ 기계로 본다.
  #   --deep = 되읽어 재계산 일치까지(실측 1.9초 · 게이트 20초 대비 싸다. 룰 미범프 회귀는 이쪽만 잡는다).
  node tools/replay/verify.mjs --deep
}

case "$cmd" in
  check)    check ;;
  test)     test_all ;;
  doccheck) doccheck ;;
  gc)       gc ;;
  gate)     check && test_all && doccheck && rulebook_check && replay_check && echo "== ./dev gate: ALL GREEN ==" ;;
  done)     shift; publish_done "$@" ;;
  clear-check) clear_report "$(git symbolic-ref --short HEAD 2>/dev/null || echo detached)" ;;
  fuzz)     shift
            # 속성 테스트 대케이스(무작위 시드) — 소케이스는 done이 상시 돌린다. 실패 시 출력된 seed로 재현.
            RUNS="${1:-2000}"
            FESIM_FUZZ="$RUNS" pnpm -C packages/engine run test tests/property.test.ts \
              && echo "== ./dev fuzz: GREEN (numRuns=$RUNS) ==" ;;
  extract)  shift; "$PY" tools/pipeline/extract.py "$@" ;;
  transform) shift; "$PY" tools/pipeline/transform.py "$@" ;;
  verify-m002) shift; "$PY" tools/pipeline/verify_m002.py "$@" ;;
  verify-all) shift; "$PY" tools/pipeline/verify_all.py "$@" ;;
  notes)    shift; "$PY" tools/pipeline/build_notes.py "$@" ;;
  rulebook) shift
            # 룰북 생성 — ☠코드에서 뽑아낸다(손으로 쓰지 않는다). --check = 신선도만 판정.
            node tools/rulebook/build.mjs "$@" ;;
  bake)     shift; "$PY" tools/pipeline/bake_assets.py "$@" ;;
  replay)   shift
            # 챕터 기보 생성 — 헤드리스 완주 후 data/fe17/replays/<cid>.eph.json (= 맵의 기본 기보).
            # ☠승리·자군 무손실·검증 통과가 아니면 실패로 끝난다(리포트의 verified/playerLost 확인).
            [ $# -ge 1 ] || { echo "usage: ./dev replay <cid> [--difficulty l] [--max-turns 40] [--carry <앞 챕터 eph.json>] [--seed <정수>] [--out <path>] [--no-opening]"; exit 2; }
            node tools/replay/make.mjs "$@" ;;
  replay:verify) shift
            # 저장소 기보 신선도 — 기본은 ruleVersion 대조, --deep은 재계산 일치까지(게이트가 쓰는 쪽).
            node tools/replay/verify.mjs "$@" ;;
  opening)  shift
            # 오프닝 수순 검수 — 사람이 적은 수순(data/fe17/openings/<cid>.json)이 우리 국면에서
            # 무엇을 가리키는지 출력한다. ☠기보는 쓰지 않는다(해석 확인 전용, design/opening_script.md §4).
            [ "${1:-}" = "check" ] || { echo "usage: ./dev opening check <cid> [--seed <정수>] [--carry <앞 기보>]"; exit 2; }
            shift
            [ $# -ge 1 ] || { echo "usage: ./dev opening check <cid> [--seed <정수>] [--carry <앞 기보>]"; exit 2; }
            node tools/replay/make.mjs "$@" --opening-check ;;
  saves)    shift
            # 넘버링 세이브 조회 — ★Claude가 "세이브 7"을 국면으로 읽는 경로.
            # ☠정본은 브라우저(localStorage)이고 이 디렉터리는 **로컬 dev로 플레이한 세이브의 사본**이다
            #   (베타 채널 세이브는 미러가 없어 여기 안 나온다 — 목록의 복사 버튼으로 옮긴다).
            PYBIN="$PY"; [ -x "$PYBIN" ] || PYBIN=python3
            "$PYBIN" - "$ROOT/data/fe17/saves" "$@" <<'PYEOF'
import json, sys
from pathlib import Path

d = Path(sys.argv[1])
args = sys.argv[2:]
try:
    index = json.loads((d / "index.json").read_text())
except Exception:
    print(f"세이브 없음 ({d}) — 로컬 dev 서버에서 SAVE를 누르면 생긴다")
    raise SystemExit(0)

if args[:1] == ["show"]:
    n = int(args[1])
    s = next((s for s in index if s["n"] == n), None)
    if s is None:
        print(f"세이브 {n} 없음"); raise SystemExit(1)
    print(json.dumps(s, ensure_ascii=False, indent=2))
    f = d / f"{n:03d}.eph.json"
    print(f"기보: {f}")
    eph = json.loads(f.read_text())
    print(f"룰버전 {eph['ruleVersion']} · 시드 {eph.get('seed')} · {len(eph['log'])}스텝")
    print("마지막 수:")
    for step in eph["log"][-5:]:
        print("  " + json.dumps(step["action"], ensure_ascii=False))
    raise SystemExit(0)

print(f"== 넘버링 세이브 {len(index)}건 ({d}) ==")
for s in index:
    origin = f"난입({s.get('from','?')})" if s.get("origin") == "replay" else "직접"
    label = f" [{s['label']}]" if s.get("label") else ""
    print(f"  {s['n']:03d}  {s['cid']} {s['difficulty']}  T{s['turn']}p{s['phase']}  "
          f"{s['steps']}수  자군 {s['alive']}/{s['total']}  {origin}  {s['created'][:16]}{label}")
PYEOF
            ;;
  link:put) shift
            # 공유 링크 수동 등재(발급 API는 M4). 키 = id 그대로 · 값 = .eph 원문(@fesim/api 계약).
            [ $# -ge 2 ] || { echo "usage: ./dev link:put <id> <eph.json> [--local]"; exit 2; }
            ID="$1"; FILE="$2"; shift 2
            # 기본은 원격(공유 링크가 실제로 열려야 등재의 의미가 있다) · --local = wrangler dev 로컬 상태.
            SCOPE="--remote"
            [ "${1:-}" = "--local" ] && SCOPE="--local"
            "$WRANGLER" kv key put "$ID" --path "$FILE" --binding LINKS "$SCOPE" -c "$ROOT/wrangler.jsonc" ;;
  perf)     shift
            # 열람 경로 릴리즈 게이트(§11) = **LCP<1s(모바일 4G 시뮬, lighthouserc.json)뿐**이다.
            # ★/s/ JS 예산은 **참고 지표**다(2026-08-19 사용자 결정 = CLAUDE.md 성능 행 "용량은 게이트 아님 —
            #   JS 100KB·보드 JSON = 참고 지표"). 그래서 초과해도 실패시키지 않는다 — ./dev size와 같은 규칙이다.
            #   ☠exit 1로 되돌리려면 그 전에 CLAUDE.md의 "용량은 게이트 아님"부터 바꿔라(명령과 정책은 같은 말을 한다).
            [ $# -ge 1 ] || { echo "usage: ./dev perf <URL>  (프리뷰/베타의 /s/<id> 주소)"; exit 2; }
            URL="$1"
            BUDGET=102400; TOTAL=0
            for f in apps/web/dist/client/_astro/client.*.js apps/web/dist/client/_astro/BoardView.*.js \
                     apps/web/dist/client/_astro/react.*.js apps/web/dist/client/_astro/ReplayIsland.*.js; do
              [ -e "$f" ] || { echo "perf: $f 없음 — 먼저 pnpm build"; exit 1; }
              SZ=$(gzip -c "$f" | wc -c); TOTAL=$((TOTAL + SZ))
              echo "  $(basename "$f"): ${SZ}B gz"
            done
            echo "perf: /s/ JS 합계 ${TOTAL}B gz (참고 예산 ${BUDGET}B)"
            [ "$TOTAL" -le "$BUDGET" ] || echo "perf: ⚠번들이 참고 예산을 넘는다(게이트 아님 — 실패시키지 않는다)"
            CHROME_PATH="${CHROME_PATH:-$(find ~/.cache/puppeteer/chrome -name chrome -type f 2>/dev/null | sort | tail -1)}"
            export CHROME_PATH
            pnpm exec lhci collect --url="$URL" && pnpm exec lhci assert
            echo "== ./dev perf: GREEN (URL=$URL, 표본 3회 중앙값) ==" ;;
  size)     shift
            # ★보드 JSON 용량 = **참고 지표**다(2026-08-19 사용자 결정: 릴리즈 게이트는 렌더링·응답만).
            #   그래서 초과해도 실패시키지 않는다 — 경고만 찍고 0으로 끝난다.
            #   ☠exit 1로 되돌리려면 그 전에 CLAUDE.md의 "용량은 게이트 아님"부터 바꿔라(명령과 정책은 같은 말을 한다).
            BUDGET=51200; BAD=0; N=0; MAX=0; MAXF=""
            for f in apps/web/dist/client/fe17/boards/*.json; do
              [ -e "$f" ] || { echo "size: 보드 JSON 없음 — 먼저 pnpm build"; exit 1; }
              SZ=$(gzip -c "$f" | wc -c); N=$((N + 1))
              [ "$SZ" -gt "$MAX" ] && { MAX="$SZ"; MAXF="$(basename "$f")"; }
              [ "$SZ" -le "$BUDGET" ] || { echo "  ⚠$(basename "$f"): ${SZ}B gz (참고 예산 ${BUDGET}B)"; BAD=$((BAD + 1)); }
            done
            echo "size: 보드 JSON ${N}건 · 최대 ${MAXF} ${MAX}B gz · 참고 예산 ${BUDGET}B"
            [ "$BAD" -eq 0 ] || echo "size: ⚠${BAD}건이 참고 예산을 넘는다(게이트 아님 — 실패시키지 않는다)"
            echo "== ./dev size: 보고 완료(게이트 아님) ==" ;;
  promote)  shift
            ID="${1:-$(npx wrangler versions list --json 2>/dev/null | python3 -c 'import json,sys;vs=json.load(sys.stdin);vs.sort(key=lambda v:v["metadata"]["created_on"]);print(vs[-1]["id"])')}"
            npx wrangler versions deploy "$ID@100%" -y ;;
  builder:publish)
            # 빌더 단독 채널(☠비계 — rules/deploy.md §빌더 채널). 경량 게이트 = 타입 + 웹 테스트만 —
            # 본체 게이트(기보·룰북)와 분리해 작은 피쳐를 마감 절차 없이 낸다(2026-08-31 사용자 결정).
            check && pnpm -C apps/web exec vitest run || { echo "☠ builder:publish 중단: 경량 게이트 레드"; exit 1; }
            pnpm -C apps/web build || exit 1
            "$WRANGLER" deploy -c "$ROOT/wrangler.builder.jsonc" \
              && echo "== builder:publish: https://fb.emblemengage.workers.dev/ko/fe17/builder ==" ;;
  *)        echo "usage: ./dev done [--dry-run]|gate|builder:publish|clear-check|test|check|doccheck|gc|fuzz [runs]|extract|transform [--all|--chapter M004]|notes|verify-m002|verify-all [--partial]|bake [--all|--chapter M004]|replay <cid>|replay:verify [--deep]|opening check <cid>|saves [show <n>]|promote [버전ID]|link:put <id> <eph.json> [--local]|perf <URL>|size"; exit 2 ;;
esac
