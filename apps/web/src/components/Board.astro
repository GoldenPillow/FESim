---
import type { ChapterData } from "@fesim/shared";
import BoardIsland from "./BoardIsland";
import { boardProps } from "../lib/fe17";
import { UI, type Locale } from "../lib/i18n";

/**
 * SSG 셸 — 테이블 조회·파생(색·이름·이동력·사거리)은 전부 여기(빌드 타임)서 끝내고,
 * 아일랜드에는 직렬화 props만 준다. 대용량 테이블 JSON이 클라이언트 번들에 새면 안 된다.
 */
interface Props {
  locale: Locale;
  mapId: string;
  chapter: ChapterData;
}
const { locale, mapId, chapter } = Astro.props;
const t = UI[locale];
const props = boardProps(chapter, mapId, locale, {
  board: t.board,
  forecast: t.forecast,
  hit: t.hit,
  crit: t.crit,
  damage: t.damage,
  currentPosNote: t.currentPosNote,
  difficulty: t.difficulty,
  diffNames: { n: t.diffN, h: t.diffH, l: t.diffL },
});
---

<BoardIsland {...props} client:load />
