---
import {
  chapter,
  tileColorAt,
  tileName,
  isBlocked,
  phaseOfGroup,
  unitsFor,
  forceStyle,
  FLIP_X,
  FLIP_Y,
} from "../lib/fe17";
import { UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];
const map = chapter.map;
const units = unitsFor(locale);
const gridRow = (y: number) => (FLIP_Y ? map.height - y : y + 1);
const gridCol = (x: number) => (FLIP_X ? map.width - x : x + 1);
const xs = Array.from({ length: map.width }, (_, i) => i);
const ys = Array.from({ length: map.height }, (_, i) => i);
---

<figure class="plate" style={`--cols:${map.width};--rows:${map.height}`} aria-label={t.board}>
  <div class="rail rail-x">{xs.map((x) => <span style={`grid-column:${gridCol(x)}`}>{x}</span>)}</div>
  <div class="rail rail-y">{ys.map((y) => <span style={`grid-row:${gridRow(y)}`}>{y}</span>)}</div>

  <div class="board">
    <div class="layer">
      {
        map.terrain.map((line, y) =>
          line.map((tid, x) => (
            <i
              class:list={["tile", isBlocked(tid) && "blocked"]}
              title={`(${x}, ${y}) ${tileName(locale, tid)}`}
              style={`grid-column:${gridCol(x)};grid-row:${gridRow(y)};background:${tileColorAt(tid, x, y)}`}
            />
          )),
        )
      }
    </div>

    <div class="vignette"></div>

    <div class="layer units">
      {
        units.map((u) => (
          <span
            class="cell"
            data-phase={phaseOfGroup(u.group)}
            style={`grid-column:${gridCol(u.unit.x)};grid-row:${gridRow(u.unit.y)};--force:${forceStyle(u.unit.force).ring}`}
          >
            {u.icon ? (
              <img
                src={u.icon}
                alt={`${u.name} — ${u.job}`}
                class="icon"
                width="48"
                height="48"
                loading="eager"
                decoding="sync"
              />
            ) : (
              <span
                class="chip"
                title={`${u.name} — ${u.job}`}
                style={`background:${forceStyle(u.unit.force).chip}`}
              >
                {u.abbr}
              </span>
            )}
          </span>
        ))
      }
    </div>
  </div>

</figure>

<style>
  /* 좌표 레일은 절대 배치 — 플레이트 박스 = 보드 박스여야 보드가 정확히 화면 중앙에 온다. */
  .plate {
    --tile: 36px;
    position: relative;
    width: calc(var(--cols) * var(--tile));
    margin: 0;
  }

  .rail {
    display: grid;
    font-size: 9px;
    line-height: 1;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .rail-x {
    position: absolute;
    bottom: 100%;
    left: 0;
    right: 0;
    grid-template-columns: repeat(var(--cols), var(--tile));
    justify-items: center;
    padding-bottom: 0.35rem;
  }
  .rail-x span {
    grid-row: 1;
  }
  .rail-y {
    position: absolute;
    right: 100%;
    top: 0;
    bottom: 0;
    grid-template-rows: repeat(var(--rows), var(--tile));
    align-items: center;
    justify-items: end;
    padding-right: 0.35rem;
  }
  .rail-y span {
    grid-column: 1;
  }

  .board {
    position: relative;
    box-shadow:
      0 0 0 1px var(--board-frame),
      0 0 0 4px var(--ground),
      0 0 0 5px var(--board-frame),
      var(--board-shadow);
  }

  .layer {
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tile));
    grid-template-rows: repeat(var(--rows), var(--tile));
  }
  .units {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: visible;
  }

  .tile {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }
  .tile.blocked {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.07),
      inset 0 0 8px rgb(0 0 0 / 0.28);
  }

  .cell {
    position: relative;
    display: grid;
    place-items: center;
  }
  /* 발밑 앵커 — 48px 캔버스의 접지선(하단 여백 약 0.19)이 타일 바닥에 오도록 고정해
     확대해도 위로만 자란다(FE 맵 스프라이트 문법). */
  .icon {
    position: absolute;
    left: 50%;
    bottom: calc(var(--tile) * -0.29);
    transform: translateX(-50%);
    transform-origin: bottom center;
    width: calc(var(--tile) * 2);
    height: calc(var(--tile) * 2);
    object-fit: contain;
    image-rendering: pixelated;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }
  .chip {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--tile) * 0.82);
    height: calc(var(--tile) * 0.82);
    border-radius: 9999px;
    border: 2px solid var(--force);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.45);
  }

  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.22));
  }


  @media (max-width: 1024px) {
    .plate {
      --tile: 30px;
    }
  }
  @media (max-width: 640px) {
    .plate {
      --tile: 22px;
    }
  }
</style>
