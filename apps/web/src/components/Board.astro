---
import BoardIsland from "./BoardIsland";
import { boardPropsFor } from "../lib/fe17";
import { type Locale } from "../lib/i18n";

/**
 * SSG 셸 — 테이블 조회·파생(색·이름·이동력·사거리)은 전부 boardPropsFor(빌드 타임)가 끝내고,
 * 아일랜드에는 직렬화 props만 준다. 대용량 테이블 JSON이 클라이언트 번들에 새면 안 된다.
 * 같은 산출물을 /fe17/boards/*.json 엔드포인트가 dist로 내보낸다(공유 열람의 입력).
 */
interface Props {
  locale: Locale;
  mapId: string;
}
const { locale, mapId } = Astro.props;
---

<BoardIsland {...boardPropsFor(mapId, locale)} client:load />
