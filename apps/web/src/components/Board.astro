---
import {
  chapter,
  tileColorAt,
  tileName,
  isBlocked,
  unitsFor,
  forceStyle,
  FLIP_X,
  FLIP_Y,
} from "../lib/fe17";
import { UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = UI[locale];
const map = chapter.map;
const units = unitsFor(locale);
const gridRow = (y: number) => (FLIP_Y ? map.height - y : y + 1);
const gridCol = (x: number) => (FLIP_X ? map.width - x : x + 1);
const xs = Array.from({ length: map.width }, (_, i) => i);
const ys = Array.from({ length: map.height }, (_, i) => i);
---

<figure class="plate" style={`--cols:${map.width};--rows:${map.height}`} aria-label={t.board}>
  <div class="rail rail-x">{xs.map((x) => <span style={`grid-column:${gridCol(x)}`}>{x}</span>)}</div>
  <div class="rail rail-y">{ys.map((y) => <span style={`grid-row:${gridRow(y)}`}>{y}</span>)}</div>

  <div class="board">
    <div class="layer">
      {
        map.terrain.map((line, y) =>
          line.map((tid, x) => (
            <i
              class:list={["tile", isBlocked(tid) && "blocked"]}
              title={`(${x}, ${y}) ${tileName(locale, tid)}`}
              style={`grid-column:${gridCol(x)};grid-row:${gridRow(y)};background:${tileColorAt(tid, x, y)}`}
            />
          )),
        )
      }
    </div>

    <div class="layer units">
      {
        units.map((u) => (
          <span
            class="cell"
            style={`grid-column:${gridCol(u.unit.x)};grid-row:${gridRow(u.unit.y)};--force:${forceStyle(u.unit.force).ring}`}
          >
            {u.icon ? (
              <img
                src={u.icon}
                alt={`${u.name} — ${u.job}`}
                class="icon"
                width="48"
                height="48"
                loading="eager"
                decoding="sync"
              />
            ) : (
              <span
                class="chip"
                title={`${u.name} — ${u.job}`}
                style={`background:${forceStyle(u.unit.force).chip}`}
              >
                {u.abbr}
              </span>
            )}
          </span>
        ))
      }
    </div>

    <div class="vignette"></div>
  </div>

</figure>

<style>
  .plate {
    --tile: 36px;
    --gutter: 1.1rem;
    display: grid;
    grid-template-columns: var(--gutter) calc(var(--cols) * var(--tile));
    grid-template-rows: var(--gutter) calc(var(--rows) * var(--tile));
    gap: 0.25rem;
  }

  .rail {
    display: grid;
    font-size: 9px;
    line-height: 1;
    color: var(--muted);
    letter-spacing: 0.04em;
  }
  .rail-x {
    grid-column: 2;
    grid-row: 1;
    grid-template-columns: repeat(var(--cols), var(--tile));
    align-items: end;
    justify-items: center;
  }
  .rail-y {
    grid-column: 1;
    grid-row: 2;
    grid-template-rows: repeat(var(--rows), var(--tile));
    align-items: center;
    justify-items: end;
    padding-right: 0.3rem;
  }

  .board {
    position: relative;
    grid-column: 2;
    grid-row: 2;
    box-shadow:
      0 0 0 1px var(--board-frame),
      0 0 0 4px var(--ground),
      0 0 0 5px var(--board-frame),
      var(--board-shadow);
  }

  .layer {
    display: grid;
    grid-template-columns: repeat(var(--cols), var(--tile));
    grid-template-rows: repeat(var(--rows), var(--tile));
  }
  .units {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .tile {
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.07);
  }
  .tile.blocked {
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.07),
      inset 0 0 8px rgb(0 0 0 / 0.28);
  }

  .cell {
    position: relative;
    display: grid;
    place-items: center;
  }
  /* 군 색 발판 — 인게임 문법(아군 파랑 / 적 빨강)을 톤다운 보드 위에서 읽히게 */
  .cell::before {
    content: "";
    position: absolute;
    bottom: 8%;
    width: calc(var(--tile) * 0.62);
    height: calc(var(--tile) * 0.26);
    border-radius: 9999px;
    background: var(--force);
    box-shadow: 0 0 0 1px rgb(0 0 0 / 0.35);
    opacity: 0.9;
  }
  .icon {
    position: relative;
    width: calc(var(--tile) * 1.33);
    height: calc(var(--tile) * 1.33);
    object-fit: contain;
    filter: drop-shadow(0 2px 3px rgb(0 0 0 / 0.5));
  }
  .chip {
    position: relative;
    display: grid;
    place-items: center;
    width: calc(var(--tile) * 0.82);
    height: calc(var(--tile) * 0.82);
    border-radius: 9999px;
    border: 2px solid var(--force);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
    box-shadow: 0 2px 4px rgb(0 0 0 / 0.45);
  }

  .vignette {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(120% 100% at 50% 40%, transparent 55%, rgb(0 0 0 / 0.22));
  }


  @media (max-width: 1024px) {
    .plate {
      --tile: 30px;
    }
  }
  @media (max-width: 640px) {
    .plate {
      --tile: 22px;
      --gutter: 0.85rem;
    }
  }
</style>
