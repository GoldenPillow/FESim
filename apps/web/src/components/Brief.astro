---
import type { ChapterData } from "@fesim/shared";
import EmblemMark from "./EmblemMark.astro";
import { objectName, tileColor, tileName, unitsFor } from "../lib/fe17";
import { phasesFor, phaseOfGroup } from "../lib/phases";
import { UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  mapId: string;
  chapter: ChapterData;
}
const { locale, mapId, chapter } = Astro.props;
const t = UI[locale];
const map = chapter.map;
const units = unitsFor(chapter, locale);
const phases = phasesFor(mapId);
const objectNames = [...new Set((map.objects ?? []).map((o) => objectName(locale, o)))];

/** 平地·道는 공식 표시명이 같다(둘 다 Ground) — 이름으로 묶고 스와치만 나열한다. */
const legend = new Map<string, string[]>();
for (const tid of new Set(map.terrain.flat())) {
  const name = tileName(locale, tid);
  legend.set(name, [...(legend.get(name) ?? []), tileColor(tid)]);
}

const counts = [
  { label: t.player, force: 0 },
  { label: t.ally, force: 2 },
  { label: t.enemy, force: 1 },
]
  .map((c) => {
    const list = units.filter((u) => u.unit.force === c.force);
    return {
      label: c.label,
      n: list.length,
      byPhase:
        c.force !== 0 && phases.length > 1
          ? phases.map((p) => ({
              id: p.id,
              n: list.filter((u) => (phaseOfGroup(mapId, u.group) ?? p.id) === p.id).length,
            }))
          : [],
    };
  })
  .filter((c) => c.n > 0);
---

<div class="text-[11px] text-muted">
  <dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
    {
      chapter.recommendedLevel !== undefined && (
        <>
          <dt>{t.recommended}</dt>
          <dd class="text-ink">
            {t.level} {chapter.recommendedLevel}
          </dd>
        </>
      )
    }
    <dt>{t.size}</dt>
    <dd class="text-ink">{map.width} × {map.height}</dd>
    {
      counts.map((c) => (
        <>
          <dt>{c.label}</dt>
          <dd class="text-ink">
            {c.byPhase.length > 0 ? (
              c.byPhase.map((p) => (
                <span data-phase={p.id}>
                  {p.n} {t.units}
                </span>
              ))
            ) : (
              <>
                {c.n} {t.units}
              </>
            )}
          </dd>
        </>
      ))
    }
  </dl>

  <h2 class="mt-5 mb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">
    {t.terrain}
  </h2>
  <ul class="flex flex-col gap-1">
    {
      [...legend].map(([name, colors]) => (
        <li class="flex items-center gap-2">
          <span class="flex gap-0.5">
            {colors.map((c) => (
              <i class="swatch" style={`background:${c}`} />
            ))}
          </span>
          <span class="text-ink">{name}</span>
        </li>
      ))
    }
  </ul>

  {
    objectNames.length > 0 && (
      <>
        <h2 class="mt-5 mb-2 text-[11px] font-semibold uppercase tracking-[0.18em] text-muted">
          {t.objects}
        </h2>
        <ul class="flex flex-col gap-1">
          {objectNames.map((name) => (
            <li class="flex items-center gap-2">
              <EmblemMark class="legend-mark" />
              <span class="text-ink">{name}</span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  <p class="mt-4 border-t border-rule pt-2 tracking-wide">{t.axis}</p>
</div>

<style>
  .swatch {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    outline: 1px solid var(--rule);
    outline-offset: -1px;
  }
</style>
