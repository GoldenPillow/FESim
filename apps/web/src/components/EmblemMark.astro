---
/** 紋章氣(Emblem Energy) 마커 — 엔게이지 문양 모티프: 발광 링 + 결정. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg class:list={["emblem", className]} viewBox="0 0 32 32" aria-hidden="true">
  <circle cx="16" cy="16" r="12.5" fill="none" stroke="currentColor" stroke-width="1" opacity="0.4"
  ></circle>
  <circle cx="16" cy="16" r="9" fill="none" stroke="currentColor" stroke-width="2"></circle>
  <path d="M16 5.5 L19.5 16 L16 26.5 L12.5 16 Z" fill="currentColor" opacity="0.9"></path>
  <path d="M16 10.5 L17.6 16 L16 21.5 L14.4 16 Z" fill="#f2fffd" opacity="0.85"></path>
</svg>

<style>
  /* --tile은 보드가 소유한다(상속) — 범례에서는 고정 크기. */
  .tile-mark {
    width: calc(var(--tile) * 1.05);
    height: calc(var(--tile) * 1.05);
  }
  .legend-mark {
    width: 0.95rem;
    height: 0.95rem;
  }
  .emblem {
    color: #45e3d8;
    filter: drop-shadow(0 0 5px rgb(69 227 216 / 0.7)) drop-shadow(0 1px 2px rgb(0 0 0 / 0.6));
    animation: emblem-pulse 2.8s ease-in-out infinite;
  }
  @keyframes emblem-pulse {
    0%,
    100% {
      opacity: 0.8;
      transform: scale(0.95);
    }
    50% {
      opacity: 1;
      transform: scale(1.05);
    }
  }
</style>
