---
import type { ChapterData } from "@fesim/shared";
import { unitsFor, forceStyle } from "../lib/fe17";
import { UI, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  mapId: string;
  chapter: ChapterData;
}
const { locale, mapId, chapter } = Astro.props;
const t = UI[locale];
// ☠보드 유닛 id 계약 = `u{순번}` — boardProps.units도 같은 unitsFor 순서를 쓴다.
// 이 id가 있어야 아일랜드가 레벨업·피해·전사를 이 카드에 되쏠 수 있다(로스터는 SSR 정적이라
// 그대로 두면 개막 수치에 얼어붙는다).
const units = unitsFor(chapter, locale).map((view, i) => ({ view, id: `u${i}` }));
void mapId;
/** force 0/1/2 = 아군/적군/우군 — 우군을 적군 절에 섞지 않는다. */
const sections = [
  { title: t.player, force: 0 },
  { title: t.ally, force: 2 },
  { title: t.enemy, force: 1 },
]
  .map((sec) => ({
    title: sec.title,
    accent: forceStyle(sec.force).ring,
    list: units.filter((u) => u.view.unit.force === sec.force),
  }))
  .filter((sec) => sec.list.length > 0);
---

<div class="flex flex-col gap-5" data-roster>
  {
    sections.map((s) => (
      <section>
        <h2 class="mb-2 flex items-baseline gap-2 text-[11px] font-semibold uppercase tracking-[0.18em]">
          <span style={`color:${s.accent}`}>{s.title}</span>
          <span class="h-px flex-1" style={`background:${s.accent};opacity:.35`} />
          <span class="text-muted">{s.list.length}</span>
        </h2>

        <ul class="flex flex-col gap-1">
          {s.list.map(({ view: u, id }) => (
            <li>
              <details class="card" data-uid={id} style={`--force:${forceStyle(u.unit.force).ring}`}>
                <summary>
                  {u.face ? (
                    <img src={u.face} alt="" class="portrait" width="41" height="31" />
                  ) : u.icon ? (
                    <span class="portrait sprite">
                      <img src={u.icon} alt="" width="48" height="48" />
                    </span>
                  ) : (
                    <span class="portrait initials">{u.abbr}</span>
                  )}
                  <span class="min-w-0 flex-1">
                    <span class="block truncate text-[13px] leading-tight text-ink">{u.name}</span>
                    <span class="block truncate text-[11px] leading-tight text-muted">{u.job}</span>
                  </span>
                  <span class="shrink-0 text-right text-[11px] leading-tight text-muted">
                    <span class="block">
                      {t.level} <b class="ru-lv">{u.level}</b>
                      <b class="ru-exp" />
                    </span>
                    <span class="block opacity-70 ru-pos">
                      {u.unit.x}, {u.unit.y}
                    </span>
                  </span>
                </summary>

                <dl class="detail">
                  {u.items.length > 0 && (
                    <>
                      <dt>{t.items}</dt>
                      <dd>{u.items.join(" · ")}</dd>
                    </>
                  )}
                  {u.skills.length > 0 && (
                    <>
                      <dt>{t.skills}</dt>
                      <dd>
                        {u.skills.map((sk, i) => (
                          <>
                            {i > 0 && " · "}
                            {sk.deferred ? (
                              <span class="skill-deferred" title={t.fidelity.unsupportedSkill}>
                                {sk.name}
                              </span>
                            ) : (
                              sk.name
                            )}
                          </>
                        ))}
                      </dd>
                    </>
                  )}
                  <dt>{t.group}</dt>
                  <dd>{u.group}</dd>
                </dl>
              </details>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</div>

<style>
  /* 아일랜드가 되쏘는 라이브 값 — 레벨은 강조, 경험치는 노란 꼬리표(맵 경험치 바와 같은 색). */
  .ru-lv {
    font-weight: 700;
    color: var(--ink);
  }
  .ru-exp:not(:empty) {
    margin-left: 0.3rem;
    color: #ffd23e;
    font-weight: 400;
  }
  /* 전사 = 목록에서 지우지 않고 남긴다(누가 죽었는지가 전략 정보다). */
  .card.gone {
    opacity: 0.4;
  }
  .card.gone .ru-lv {
    text-decoration: line-through;
  }
  .card {
    border: 1px solid var(--rule);
    border-left: 2px solid var(--force);
    border-radius: 3px;
    background: var(--panel);
    transition: border-color 160ms ease;
  }
  .card:hover {
    border-color: color-mix(in srgb, var(--force) 45%, var(--rule));
    border-left-color: var(--force);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.45rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .portrait {
    width: var(--m-roster-face-w);
    height: var(--m-roster-face-h);
    flex-shrink: 0;
    border-radius: 2px;
    object-fit: cover;
    object-position: 50% 32%;
    background: var(--sunken);
    box-shadow: inset 0 0 0 1px var(--rule);
  }
  /* 얼굴 썸네일이 없는 유닛은 맵 아이콘을 확대해 얼굴 자리에 쓴다(픽셀아트 = pixelated). */
  .sprite {
    position: relative;
    overflow: hidden;
    background: color-mix(in srgb, var(--force) 16%, var(--sunken));
  }
  /* 맵 스프라이트는 캔버스 하단 접지(발밑 여백 ~19%) — 얼굴은 세로 40~60% 부근이라
     상단이 아니라 중하단을 창에 맞춘다(상단 크롭 = 빈 하늘만 보이는 잘림 버그의 원인). */
  .sprite img {
    position: absolute;
    left: 50%;
    top: var(--m-roster-sprite-top);
    transform: translateX(-50%);
    width: var(--m-roster-sprite);
    height: var(--m-roster-sprite);
    max-width: none;
    object-fit: contain;
    image-rendering: pixelated;
  }
  .initials {
    display: grid;
    place-items: center;
    font-size: 11px;
    font-weight: 700;
    color: var(--muted);
  }
  .detail {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.15rem 0.6rem;
    border-top: 1px solid var(--rule);
    margin: 0;
    padding: 0.4rem 0.5rem;
    font-size: 11px;
  }
  .detail dt {
    color: var(--muted);
  }
  .detail dd {
    margin: 0;
    color: var(--ink);
  }
  /* 미재현 기전이 화면에 드러나는 지점의 정직 표기(verification.md §2-1) — 점선 + 툴팁. */
  .skill-deferred {
    color: var(--muted);
    text-decoration: underline dotted;
    text-underline-offset: 3px;
    cursor: help;
  }
</style>
