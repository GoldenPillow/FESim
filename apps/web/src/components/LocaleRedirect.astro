---
/** 비로케일 경로 진입점 — navigator.language로 en|ja|ko 분기(기본 en). */
interface Props {
  target: string;
}
const { target } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`/en${target}`} />
    <title>FESim</title>
    <script is:inline define:vars={{ target }}>
      const nav = (navigator.language || "en").toLowerCase();
      const lang = nav.startsWith("ko") ? "ko" : nav.startsWith("ja") ? "ja" : "en";
      location.replace(`/${lang}${target}`);
    </script>
    <noscript><meta http-equiv="refresh" content={`0; url=/en${target}`} /></noscript>
  </head>
  <body></body>
</html>
