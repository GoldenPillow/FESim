---
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  id="theme-toggle"
  aria-label={label}
  title={label}
  class="grid size-9 place-items-center rounded-full border border-rule text-ink transition-colors hover:bg-sunken"
>
  <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" class="icon">
    <mask id="crescent">
      <rect x="0" y="0" width="24" height="24" fill="white"></rect>
      <circle cx="12" cy="12" r="9" fill="black" class="bite"></circle>
    </mask>
    <circle cx="12" cy="12" r="9" mask="url(#crescent)" fill="currentColor" class="orb"></circle>
    <g class="rays" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
      <line x1="12" y1="1.5" x2="12" y2="4"></line>
      <line x1="12" y1="20" x2="12" y2="22.5"></line>
      <line x1="1.5" y1="12" x2="4" y2="12"></line>
      <line x1="20" y1="12" x2="22.5" y2="12"></line>
      <line x1="4.2" y1="4.2" x2="6" y2="6"></line>
      <line x1="18" y1="18" x2="19.8" y2="19.8"></line>
      <line x1="19.8" y1="4.2" x2="18" y2="6"></line>
      <line x1="6" y1="18" x2="4.2" y2="19.8"></line>
    </g>
  </svg>
</button>

<style>
  .icon {
    overflow: visible;
  }
  .orb,
  .bite,
  .rays {
    transform-box: view-box;
    transform-origin: 12px 12px;
    transition:
      transform 480ms cubic-bezier(0.34, 1.3, 0.64, 1),
      opacity 260ms ease;
  }
  /* 기본 = 다크 = 달 */
  .orb {
    transform: scale(0.82);
  }
  .bite {
    transform: translate(7px, -5px);
  }
  .rays {
    opacity: 0;
    transform: scale(0.45) rotate(-45deg);
  }
  :global(html[data-theme="light"]) .orb {
    transform: scale(0.56);
  }
  :global(html[data-theme="light"]) .bite {
    transform: translate(22px, -18px);
  }
  :global(html[data-theme="light"]) .rays {
    opacity: 1;
    transform: scale(1) rotate(0deg);
  }
</style>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "light" ? "dark" : "light";
    document.documentElement.dataset.theme = next;
    localStorage.setItem("fesim-theme", next);
  });
</script>
