---
export const prerender = false;

import { env } from "cloudflare:workers";
import { getReplay, statusFor } from "@fesim/api";
import { toAddress, toCursor, type UnitState } from "@fesim/engine";
import type { EphemerisFile } from "@fesim/shared";
import Base from "../../layouts/Base.astro";
import ReplayFrame, { type ReplayFrameProps } from "../../components/ReplayFrame";
import ReplayIsland from "../../components/ReplayIsland";
import { boardsJsonPath } from "../../lib/boards";
import { initGame, replayer } from "../../lib/boardStore";
import { readAddress } from "../../lib/replayQuery";
import { tileKey } from "../../lib/grid";
import { DEFAULT_LOCALE, UI, isLocale } from "../../lib/i18n";
import type { BoardProps } from "../../lib/fe17";

/**
 * 공유 열람(포커스 모드) — 링크 하나로 남의 전략을 연다.
 * ☠이 라우트만 온디맨드다(나머지는 전부 SSG). 워커에 테이블을 반입하지 않기 위해
 * 보드는 빌드 산출물(/fe17/boards/*.json)을 에셋 바인딩으로 읽는다.
 */
const query = Astro.url.searchParams;
const raw = query.get("l") ?? undefined;
const locale = isLocale(raw) ? raw : DEFAULT_LOCALE;
const t = UI[locale];

let failure: string | undefined;
let file: EphemerisFile | undefined;
let board: BoardProps | undefined;
let cursor = 0;
let frame: ReplayFrameProps | undefined;

if (env.LINKS === undefined) {
  Astro.response.status = 503;
  failure = t.focus.notFound;
} else {
  // cacheTtl 5분: 응답 캐시(미들웨어)를 비껴가는 쿼리 변형(?t/p/a)의 KV 재읽기를 PoP에 캐시.
  // ☠부작용 = 미스도 5분 캐시된다(등재 직전 프로브가 새 링크를 그 PoP에서 잠시 가릴 수 있음) — 짧게 유지하는 이유.
  const links = env.LINKS;
  const link = await getReplay({ get: (key) => links.get(key, { cacheTtl: 300 }) }, Astro.params.id);
  if (!link.ok) {
    Astro.response.status = statusFor(link.reason);
    failure = link.reason === "corrupt" ? t.focus.broken : t.focus.notFound;
  } else {
    file = link.file;
    // 프로덕션 = ASSETS 바인딩(자기 오리진 재요청 없음) · astro dev = 자기 오리진 폴백.
    const url = new URL(boardsJsonPath(file.chapter.cid, locale), Astro.url);
    const res = env.ASSETS === undefined ? await fetch(url) : await env.ASSETS.fetch(url);
    if (!res.ok) {
      Astro.response.status = 404;
      failure = t.focus.notFound;
      file = undefined;
    } else {
      board = (await res.json()) as BoardProps;
      try {
        const base = initGame(board, file.chapter.difficulty, file.chapter.scenario);
        const timeline = replayer.buildTimeline(base.game, file.log);
        const wanted = readAddress(query);
        cursor = wanted === undefined ? 0 : toCursor(timeline, wanted);
        // 정적 프레임이 첫 페인트(LCP)의 전부다 — 기보·보드 props는 문서에 싣지 않는다(아일랜드가 fetch).
        // 아이콘 data URI 인라인은 미들웨어가 이 마크업에 적용한다.
        const state = replayer.stateAt(timeline, cursor);
        const alive = state.units.filter((u) => !u.dead);
        const byTile = new Map<string, UnitState>();
        for (const u of alive) byTile.set(tileKey(u.x, u.y), u);
        frame = {
          board,
          address: toAddress(timeline, cursor),
          at: cursor,
          steps: timeline.steps.length,
          labels: t.focus,
          alive,
          byTile,
          visuals: base.visuals,
          selectedId: query.get("u") ?? undefined,
        };
      } catch {
        // 스키마는 통과했지만 재생 불가한 레코드(예: events·rolls 없는 공격) — 500 대신 깨진 기록으로 표시.
        Astro.response.status = 400;
        failure = t.focus.broken;
        file = undefined;
        board = undefined;
      }
    }
  }
}

const heading =
  board === undefined
    ? "FESim"
    : file?.meta?.title ??
      (board.title.name === "" ? board.title.prefix : `${board.title.prefix} · ${board.title.name}`);
const difficulty = board === undefined || file === undefined ? "" : board.labels.diffNames[file.chapter.difficulty];
const description = board === undefined ? t.focus.shared : `${t.focus.shared} — ${heading} · ${difficulty}`;
---

<Base locale={locale} title={`${heading} — FESim`}>
  <Fragment slot="head">
    <meta name="description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content={heading} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <meta name="twitter:card" content="summary" />
  </Fragment>

  {
    failure !== undefined || board === undefined || file === undefined ? (
      <main class="focus focus-fail">
        <p class="fail-note">{failure ?? t.focus.notFound}</p>
        <a class="focus-cta" href={`/${locale}/fe17/maps`}>
          FESim
        </a>
      </main>
    ) : (
      <main class="focus">
        <header class="focus-head">
          <h1>{heading}</h1>
          <p>
            {board.title.place}
            {board.title.place === "" ? "" : " · "}
            {difficulty}
          </p>
        </header>

        {frame !== undefined && (
          <div id="ssr-board">
            <ReplayFrame {...frame} />
          </div>
        )}
        <ReplayIsland
          id={Astro.params.id ?? ""}
          cursor={cursor}
          unit={query.get("u") ?? undefined}
          labels={t.focus}
          locale={locale}
          ssrBoardId="ssr-board"
          client:only="react"
        />

        <a class="focus-cta" href={`/${locale}/fe17/maps/${file.chapter.cid}`}>{t.focus.edit}</a>
        <a class="focus-fidelity" href={`/${locale}/fe17/fidelity`}>{t.fidelity.badge}</a>
      </main>
    )
  }

  <style>
    /* 포커스 모드 = 보드와 스테퍼만. 로스터·브리프는 없다(열람 경로의 예산이 곧 릴리즈 게이트다). */
    .focus {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.75rem;
      min-height: 100vh;
      padding: 5.5rem 1rem 3rem;
    }
    .focus-head {
      text-align: center;
    }
    .focus-head h1 {
      font-size: 1.1rem;
      letter-spacing: 0.02em;
      color: var(--ink);
    }
    .focus-head p {
      margin-top: 0.35rem;
      font-size: 11px;
      color: var(--muted);
    }
    .focus-cta {
      padding: 0.55rem 1.4rem;
      border: 1px solid var(--gold);
      border-radius: 9999px;
      font-size: 12px;
      color: var(--gold);
      transition:
        background 150ms ease,
        color 150ms ease;
    }
    .focus-cta:hover {
      background: var(--gold);
      color: var(--ground);
    }
    /* 재현 상태 진입점 — 정직 표기의 요약 배지(verification.md §2-1). 정적 앵커라 열람 예산 영향 0. */
    .focus-fidelity {
      font-size: 11px;
      color: var(--muted);
      text-decoration: underline dotted;
      text-underline-offset: 3px;
    }
    .focus-fidelity:hover {
      color: var(--ink);
    }
    .focus-fail {
      justify-content: center;
    }
    .fail-note {
      font-size: 13px;
      color: var(--muted);
    }
  </style>
</Base>
