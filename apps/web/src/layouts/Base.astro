---
import "../styles/global.css";
import { htmlLang, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem("fesim-theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <!-- 채널 워터마크(규약 — rules/deploy.md): 베타 = 황색 BETA+버전 · 릴리즈 = 청회색 버전.
         채널 판별은 호스트명(같은 빌드가 승격되므로 빌드 플래그로는 못 가른다). 버전 = git 짧은 해시. -->
    <div id="chan-mark" hidden data-build={import.meta.env.PUBLIC_BUILD ?? "dev"}></div>
    <script is:inline>
      (() => {
        const el = document.getElementById("chan-mark");
        // 빌더 단독 워커(builder-engage.*) = 오렌지 "ver. beta" (rules/deploy.md §빌더 채널, 2026-08-31)
        const fb = location.hostname.startsWith("builder-engage.");
        const beta = location.hostname.startsWith("beta-") || location.hostname === "localhost";
        el.textContent = fb ? "ver. beta " + el.dataset.build : (beta ? "BETA " : "") + el.dataset.build;
        el.classList.add(fb ? "fb" : beta ? "beta" : "rel");
        el.hidden = false;
      })();
    </script>
    <style>
      #chan-mark {
        position: fixed;
        right: 14px;
        bottom: 12px;
        z-index: 9999;
        pointer-events: none;
        /* 기본 굵기 + JetBrains Mono(사용자 규약) — 웹폰트 미탑재라 로컬 폰트 우선, 모노 폴백 */
        font-family: "JetBrains Mono", ui-monospace, "Cascadia Mono", monospace;
        font-weight: 400;
        font-size: 12px;
        letter-spacing: 0.06em;
        padding: 4px 10px;
        border-radius: 6px;
        font-variant-numeric: tabular-nums;
      }
      #chan-mark.beta {
        color: #ffd23e;
        background: rgb(20 16 4 / 0.72);
        border: 1px solid rgb(255 210 62 / 0.65);
        text-shadow: 0 0 6px rgb(255 210 62 / 0.35);
      }
      #chan-mark.fb {
        color: #ff8a3d;
        background: rgb(24 12 4 / 0.72);
        border: 1px solid rgb(255 138 61 / 0.7);
        text-shadow: 0 0 6px rgb(255 138 61 / 0.35);
      }
      #chan-mark.rel {
        color: #9db4cc;
        background: rgb(10 14 20 / 0.6);
        border: 1px solid rgb(157 180 204 / 0.4);
      }
    </style>
  </body>
</html>
