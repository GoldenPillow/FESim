---
import "../styles/global.css";
import { htmlLang, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  title: string;
}
const { locale, title } = Astro.props;
---

<!doctype html>
<html lang={htmlLang[locale]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script is:inline>
      if (localStorage.getItem("fesim-theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    </script>
    <slot name="head" />
  </head>
  <body class="min-h-screen antialiased">
    <slot />
    <!-- 베타 워터마크 — 채널 판별은 호스트명(같은 빌드가 승격되므로 빌드 플래그로는 못 가른다) -->
    <div id="beta-mark" hidden>BETA</div>
    <script is:inline>
      if (location.hostname.startsWith("beta-") || location.hostname === "localhost") {
        document.getElementById("beta-mark").hidden = false;
      }
    </script>
    <style>
      #beta-mark {
        position: fixed;
        right: 14px;
        bottom: 12px;
        z-index: 9999;
        pointer-events: none;
        font-weight: 900;
        font-size: 13px;
        letter-spacing: 0.18em;
        padding: 4px 10px;
        border-radius: 6px;
        color: #ffd23e;
        background: rgb(20 16 4 / 0.72);
        border: 1px solid rgb(255 210 62 / 0.65);
        text-shadow: 0 0 6px rgb(255 210 62 / 0.35);
      }
    </style>
  </body>
</html>
