#!/usr/bin/env bash
# main 머지 = 게이트 강제, 작업 브랜치 머지 = 경고만 ("작업대는 넓게, 머지는 정리")
# ☠./dev done이 아니라 gate다 — done은 이 머지를 **부르는** 쪽이라 부르면 재귀한다.
set -uo pipefail
ROOT="$(git rev-parse --show-toplevel)"
BRANCH="$(git -C "$ROOT" symbolic-ref --short HEAD 2>/dev/null || echo detached)"

# 마감 절차가 방금 같은 트리를 통과시켰다(머지 커밋은 트리를 바꾸지 않는다) — 두 번 돌릴 이유가 없다.
if [ "${FESIM_PUBLISHING:-}" = "1" ]; then
  echo "· 게이트 생략(./dev done이 방금 통과시킴)"
  exit 0
fi

if [ "$BRANCH" = "main" ]; then
  "$ROOT/dev" gate || { echo "☠ main 머지 차단: ./dev gate 레드"; exit 1; }
else
  "$ROOT/dev" gate || echo "⚠ 경고($BRANCH): ./dev gate 레드 — 머지는 진행됨"
fi
exit 0
